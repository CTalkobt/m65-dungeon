; load.s45 — loading a file from the disk straight through the KERNAL
;
; Each data file starts with its load address in its bank; the KERNAL loads
; it there (SETBNK, SETNAM, SETLFS with secondary address 1, LOAD) from the
; drive the program came from (8 if none). ROM calls go through crt0's
; __rom_call, which keeps the program's base page. (After pfest's load.s45.)

.cpu _45gs02
.segmentOrder code, data, bss

.global _ld_file
.global _ld_name
.global _ld_len
.global _ld_bank
.extern ___cbm_target, __rom_call

.data
_ld_name: .word 0         ; the file's name (PETSCII)
_ld_len:  .byte 0         ;   its length
_ld_bank: .byte 0         ;   the bank it loads into

.code

; unsigned char ld_file(void): 1 when the file is in
proc _ld_file
    lda #$6B              ; SETBNK: A = the data's bank, X = the name's
    sta ___cbm_target
    lda #$FF
    sta ___cbm_target+1
    lda _ld_bank
    ldx #0
    jsr __rom_call
    lda #$BD              ; SETNAM: A = length, X/Y = the name
    sta ___cbm_target
    lda _ld_len
    ldx _ld_name
    ldy _ld_name+1
    jsr __rom_call
    lda #$BA              ; SETLFS 0, the program's drive (8 if none), 1
    sta ___cbm_target
    ldx $00BA
    cpx #8
    bcs @dev
    ldx #8
@dev:
    lda #0
    ldy #1
    jsr __rom_call
    lda #$D5              ; LOAD to the file's own address
    sta ___cbm_target
    lda #0
    ldx #0
    ldy #0
    jsr __rom_call
    bcs @fail
    lda #1
    ldx #0
    rts
@fail:
    lda #0
    ldx #0
    rts
endproc
